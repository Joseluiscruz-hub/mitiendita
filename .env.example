# Credenciales de prueba de la aplicación del vendedor de prueba.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-REEMPLAZAR

# URL HTTPS pública, sin diagonal final (ej. https://mi-tienda.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Se obtiene al guardar la URL y evento Pagos en Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR
